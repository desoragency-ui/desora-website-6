---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import ContactForm from '../../components/contact/ContactForm.astro';
import ContactWhatsApp from '../../components/contact/ContactWhatsApp.astro';
import { useTranslations } from '../../i18n/utils';
import { getServices } from '../../lib/content';
import { siteConfig } from '../../lib/site-config';

const locale = 'ar' as const;
const t = useTranslations(locale);
const services = await getServices(locale);

const seoTitle = 'اتصل بنا | ديزورا';
const seoDescription = 'ناقشوا مشروعكم مع ديزورا عبر واتساب أو من خلال الاستمارة. نرد خلال 24 ساعة عمل.';
---

<BaseLayout title={seoTitle} description={seoDescription} locale={locale}>
  <PageHero
    eyebrow="اتصل بنا"
    title={"لنتحدث عن مشروعكم."}
    subtitle={"لا استمارة لا تنتهي، لا خطاب تسويقي جاهز. اختاروا ما يناسبكم: واتساب لرد فوري، أو الاستمارة لوضع أساسيات مشروعكم."}
  />

  <section class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-5" data-reveal-group>
      <div class="bezel bezel--lg lg:col-span-3"><div class="bezel-core p-8">
        <ContactForm locale={locale} services={services} />
      </div></div>
      <div class="flex flex-col gap-6 lg:col-span-2">
        <ContactWhatsApp locale={locale} />
        <div class="bezel bezel--lg"><div class="bezel-core p-8">
          <h3 class="font-display text-lg font-semibold text-text-primary">{t('footer.contact')}</h3>
          <ul class="mt-5 space-y-4 text-sm">
            <li>
              <a href={`mailto:${siteConfig.email}`} class="flex items-center gap-3 text-text-secondary hover:text-accent">
                <Icon name="email" class="h-4.5 w-4.5" />
                {siteConfig.email}
              </a>
            </li>
            <li class="flex items-center gap-3 text-text-secondary">
              <Icon name="clock" class="h-4.5 w-4.5" />
              {t('form.responseTime')}
            </li>
          </ul>
          <div class="mt-6 flex items-center gap-2 border-t border-border pt-6">
            <a
              href={siteConfig.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-11 w-11 items-center justify-center rounded-full border border-border text-text-primary transition-colors hover:border-accent hover:text-accent"
              aria-label="Instagram"
            >
              <Icon name="instagram" class="h-4.5 w-4.5" />
            </a>
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-11 w-11 items-center justify-center rounded-full border border-border text-text-primary transition-colors hover:border-accent hover:text-accent"
              aria-label="LinkedIn"
            >
              <Icon name="linkedin" class="h-4.5 w-4.5" />
            </a>
            <a
              href={siteConfig.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-11 w-11 items-center justify-center rounded-full border border-border text-text-primary transition-colors hover:border-accent hover:text-accent"
              aria-label="Facebook"
            >
              <Icon name="facebook" class="h-4.5 w-4.5" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
