---
import Icon from '../Icon.astro';
import Figure from '../Figure.astro';
import { getMedia } from '../../lib/media';

interface Props {
  heading: string;
  description: string;
  points: { icon: string; title: string; description: string }[];
  imageAlt?: string;
}

const { heading, description, points, imageAlt = '' } = Astro.props;
const image = getMedia('home-approach');
---

<section class="overflow-hidden bg-bg-secondary py-24">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
      <Figure
        src={image}
        alt={imageAlt || heading}
        ratio="4/5"
        frame
        parallax={6}
        class="rounded-[1.75rem] lg:max-w-lg"
        sizes="(max-width: 1024px) 92vw, 480px"
      />

      <div>
        <div class="max-w-2xl" data-reveal>
          <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.75rem)] font-semibold leading-tight text-text-primary">
            {heading}
          </h2>
          <p class="mt-4 text-lg text-text-secondary">{description}</p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2" data-reveal-group>
          {
            points.map((point) => (
              <div class="flex gap-4">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent">
                  <Icon name={point.icon as any} class="h-5 w-5" />
                </span>
                <div>
                  <h3 class="font-display text-xl font-semibold leading-snug text-text-primary">{point.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-text-secondary">{point.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
