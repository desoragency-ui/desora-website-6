---
import Icon from '../Icon.astro';
import { localizedPath } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  heading: string;
  description: string;
  services: Awaited<ReturnType<typeof import('../../lib/content').getServices>>;
}

const { locale, heading, description, services } = Astro.props;
---

<section id="services-grid" class="mx-auto max-w-7xl px-5 py-24 sm:px-8">
  <div class="max-w-2xl" data-reveal>
    <h2 class="font-display text-[clamp(2rem,4vw,3.25rem)] font-semibold leading-[1.08] text-text-primary">
      {heading}
    </h2>
    <p class="mt-4 text-lg leading-relaxed text-text-secondary">{description}</p>
  </div>

  <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
    {
      services.map((service, i) => (
        <a
          href={localizedPath(locale, `services/${service.slug}`)}
          class="group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-surface p-8 transition-all duration-500 [transition-timing-function:cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1.5 hover:border-accent hover:shadow-[0_20px_50px_-24px_rgba(0,0,0,0.35)]"
        >
          <span class="absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-gold transition-transform duration-500 group-hover:scale-x-100"></span>
          <span class="flex items-center justify-between">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-bg-secondary text-accent transition-colors duration-500 group-hover:bg-accent group-hover:text-accent-foreground">
              <Icon name={service.icon as any} class="h-5.5 w-5.5" />
            </span>
            <span class="numeral text-lg text-gold/50">{String(i + 1).padStart(2, '0')}</span>
          </span>
          <h3 class="mt-6 font-display text-xl font-semibold text-text-primary">{service.title}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-text-secondary">{service.tagline}</p>
          <span class="mt-6 flex items-center gap-2 text-sm font-medium text-accent">
            <span class="transition-transform duration-500 group-hover:translate-x-1 rtl:group-hover:-translate-x-1">
              <Icon name="arrow-right" class="h-4 w-4 rtl:rotate-180" />
            </span>
          </span>
        </a>
      ))
    }
  </div>
</section>
