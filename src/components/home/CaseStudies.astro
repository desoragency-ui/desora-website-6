---
interface Props {
  heading: string;
  description: string;
  items: { sector: string; challenge: string; result: string }[];
}

const { heading, description, items } = Astro.props;
---

<section class="bg-bg-secondary py-24">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-2xl" data-reveal>
      <h2 class="font-display text-[clamp(1.75rem,3.5vw,2.75rem)] font-semibold leading-tight text-text-primary">
        {heading}
      </h2>
      <p class="mt-4 text-lg text-text-secondary">{description}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3" data-reveal-group>
      {
        items.map((item) => (
          <article class="flex flex-col rounded-2xl border border-dashed border-border bg-surface p-7">
            <span class="w-fit rounded-full bg-bg-secondary px-3 py-1 text-xs font-semibold uppercase tracking-wide text-text-secondary">
              {item.sector}
            </span>
            <p class="mt-5 text-sm font-medium text-text-primary">{item.challenge}</p>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-text-secondary">{item.result}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
