---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import BrandPattern from '../BrandPattern.astro';
import { useTranslations, localizedPath } from '../../i18n/utils';
import { siteConfig } from '../../lib/site-config';
import { getMedia } from '../../lib/media';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  title: string;
  subtitle: string;
}

const { locale, title, subtitle } = Astro.props;
const t = useTranslations(locale);
const eyebrow = locale === 'ar' ? 'وكالة تسويق راقية · المغرب' : locale === 'en' ? 'Premium Marketing Agency · Morocco' : 'Agence de marketing premium · Maroc';
const heroImage = getMedia('home-hero');
const heroAlt =
  locale === 'ar'
    ? 'استوديو DESORA: ثلاثة مديرين إبداعيين يراجعون كتاب العلامة'
    : locale === 'en'
      ? 'The DESORA studio: three creative directors reviewing a brand book'
      : 'Le studio DESORA : trois directeurs créatifs revoient un livre de marque';
---

<section class="bleed-hero flex min-h-[100svh] flex-col justify-center px-5 pb-20 pt-32 sm:px-8">
  {
    heroImage && (
      <div class="bleed-media" aria-hidden="true">
        <Image
          id="hero-image"
          src={heroImage}
          alt=""
          widths={[640, 960, 1280, 1600, 2048, 2752]}
          sizes="100vw"
          format="webp"
          quality={86}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      </div>
    )
  }
  <div class="bleed-scrim" aria-hidden="true"></div>
  <BrandPattern opacity={0.035} />

  <div class="bleed-content mx-auto w-full max-w-7xl">
  <div id="hero-copy" class="w-full max-w-2xl">
    <span class="sr-only">{heroAlt}</span>
    <div id="hero-eyebrow" class="mb-6 flex items-center gap-4">
      <span class="hairline w-10 shrink-0"></span>
      <span class="overline">{eyebrow}</span>
    </div>
    <h1
      id="hero-title"
      class="font-display text-[clamp(2.75rem,7vw,5.75rem)] font-semibold leading-[1.02] tracking-[-0.015em] text-text-primary"
    >
      {title}
    </h1>
    <p id="hero-subtitle" class="mt-7 max-w-2xl text-[clamp(1.05rem,2vw,1.3rem)] leading-relaxed text-text-secondary">
      {subtitle}
    </p>
    <div id="hero-cta" class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href={localizedPath(locale, 'contact')}
        class="cta-shine press flex h-13 items-center rounded-full bg-accent-strong px-7 text-base font-semibold text-accent-foreground transition-colors duration-500 hover:bg-accent-strong-hover"
      >
        {t('cta.discussProject')}
      </a>
      <a
        href={siteConfig.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="press group flex h-13 items-center gap-2 rounded-full border border-border px-7 text-base font-semibold text-text-primary transition-all duration-500 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)] hover:border-accent hover:bg-accent/5 hover:text-accent"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
        {t('cta.whatsapp')}
      </a>
    </div>
  </div>
  </div>

  <a
    href="#services-grid"
    class="absolute bottom-8 start-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-2 text-text-secondary transition-colors hover:text-accent rtl:translate-x-1/2"
    aria-label={t('cta.seeAllServices')}
  >
    <span id="scroll-indicator-line" class="h-10 w-px origin-top bg-current"></span>
  </a>
</section>


<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { reduceMotion } from '../../scripts/motion';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  const heroSection = document.querySelector('.bleed-hero');
  const heroImage = document.getElementById('hero-image');

  if (!reduceMotion) {
    gsap.fromTo(
      '#scroll-indicator-line',
      { scaleY: 0.3, opacity: 0.4 },
      { scaleY: 1, opacity: 1, duration: 1.2, ease: 'sine.inOut', repeat: -1, yoyo: true }
    );

    // Depth on scroll: the photograph drifts slower than the page, the copy
    // lifts away a touch faster. Scrubbed, transform/opacity only.
    if (heroSection) {
      if (heroImage) {
        gsap.to(heroImage, {
          yPercent: 12,
          ease: 'none',
          scrollTrigger: { trigger: heroSection, start: 'top top', end: 'bottom top', scrub: 0.8 },
        });
      }
      gsap.to('#hero-copy', {
        yPercent: -8,
        opacity: 0.55,
        ease: 'none',
        scrollTrigger: { trigger: heroSection, start: 'top top', end: 'bottom top', scrub: 0.6 },
      });
    }
  }

  function playEntrance() {
    const eyebrow = document.getElementById('hero-eyebrow');
    const title = document.getElementById('hero-title');
    const subtitle = document.getElementById('hero-subtitle');
    const cta = document.getElementById('hero-cta');
    if (!title || !subtitle || !cta) return;

    if (reduceMotion) {
      gsap.set([eyebrow, title, subtitle, cta].filter(Boolean), { opacity: 1, y: 0 });
      if (heroImage) gsap.set(heroImage, { opacity: 1, scale: 1 });
      return;
    }

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    // The photograph opens the page: a slow aperture wipe from the centre while
    // it settles out of an over-scale. The copy rides in behind it, so the
    // sequence reads as one orchestrated moment rather than scattered fades.
    if (heroImage) {
      tl.fromTo(
        heroImage,
        { opacity: 0, scale: 1.16, filter: 'blur(14px)' },
        {
          opacity: 1,
          scale: 1.02,
          filter: 'blur(0px)',
          duration: 1.9,
          ease: 'power3.out',
          onComplete: () => heroImage.classList.add('is-drifting'),
        },
        0
      );
      tl.fromTo(
        '.bleed-scrim',
        { opacity: 0 },
        { opacity: 1, duration: 1.4, ease: 'power2.out' },
        0.25
      );
    }

    if (eyebrow) {
      tl.fromTo(eyebrow, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.7 }, 0.55);
    }

    // Line-by-line title reveal is the signature moment; fall back to a
    // plain fade if SplitText can't process this content for any reason.
    let titleLines: Element[] | null = null;
    try {
      const split = new SplitText(title, { type: 'lines', linesClass: 'hero-line' });
      titleLines = split.lines;
      gsap.set(title, { opacity: 1 });
      gsap.set(titleLines, { opacity: 0, y: 28 });
    } catch (e) {
      titleLines = null;
    }

    if (titleLines && titleLines.length) {
      tl.to(titleLines, { opacity: 1, y: 0, duration: 0.9, stagger: 0.08 }, eyebrow ? '-=0.4' : 0);
    } else {
      tl.fromTo(title, { opacity: 0, y: 28 }, { opacity: 1, y: 0, duration: 0.9 }, eyebrow ? '-=0.4' : 0);
    }

    tl.fromTo(subtitle, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8 }, '-=0.55').fromTo(
      cta,
      { opacity: 0, y: 16 },
      { opacity: 1, y: 0, duration: 0.7 },
      '-=0.5'
    );
  }

  gsap.set(['#hero-eyebrow', '#hero-title', '#hero-subtitle', '#hero-cta'], { opacity: 0 });
  // Hide the plate up front so the entrance wipe has something to reveal. Done
  // in JS (not CSS) so a failed script leaves the photograph visible.
  if (!reduceMotion && heroImage) {
    gsap.set(heroImage, { opacity: 0 });
    gsap.set('.bleed-scrim', { opacity: 0 });
  }

  const preloader = document.getElementById('preloader');
  const alreadySkipped = document.documentElement.classList.contains('preloader-skip');
  // Preloader may finish (and dispatch its event) before this module has
  // even loaded, e.g. while gsap is still being imported above. Check its
  // synchronous completion flag first instead of relying on the event alone.
  if (!preloader || alreadySkipped || (window as any).__desoraPreloaderDone) {
    playEntrance();
  } else {
    window.addEventListener('desora:preloader-done', playEntrance, { once: true });
  }
</script>
