---
import Icon from '../Icon.astro';

interface Props {
  heading: string;
  items: { icon: string; label: string }[];
}

const { heading, items } = Astro.props;
const track = [...items, ...items, ...items];
---

<section class="border-y border-border bg-bg-secondary py-14" aria-label={heading}>
  <p class="overline mx-auto mb-8 max-w-7xl px-5 text-center sm:px-8">
    {heading}
  </p>
  <div class="group relative overflow-hidden">
    <div class="marquee-track flex w-max items-center gap-4">
      {
        track.map((item) => (
          <div class="flex shrink-0 items-center gap-2.5 rounded-full border border-border bg-surface px-5 py-3 text-text-secondary opacity-70 transition-all duration-300 hover:border-accent hover:text-accent hover:opacity-100">
            <Icon name={item.icon as any} class="h-4.5 w-4.5" />
            <span class="whitespace-nowrap text-sm font-medium">{item.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: marquee-move 42s linear infinite;
  }

  .group:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-move {
    from {
      transform: translateX(-33.3334%);
    }
    to {
      transform: translateX(0%);
    }
  }

  :global(html[dir='rtl']) .marquee-track {
    animation-direction: reverse;
  }
</style>
