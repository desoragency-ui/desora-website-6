---
import { clients } from '../../lib/clients';
import type { Locale } from '../../i18n/config';

/**
 * The client strip.
 *
 * A continuous marquee travelling right to left rather than a static grid: the
 * roster is long enough that a grid either wraps into an awkward last row or
 * forces the marks too small to read. Moving, they stay at a legible size and
 * the section reads as a running credit rather than a table.
 *
 * At rest every mark is painted in a single ink through mask-image, so twelve
 * logos drawn by twelve different designers read as one considered set and
 * follow the theme. Hovering a mark releases its real colours and pauses the
 * strip so it can actually be read.
 *
 * Driven by `initMarquees` in src/scripts/motion.ts, which handles the RTL
 * direction flip and the pause-on-hover. Two copies, because that is what the
 * script's wrap maths expects.
 */
interface Props {
  locale: Locale;
  heading: string;
  note?: string;
}

const { locale, heading, note } = Astro.props;
const builtLabel =
  locale === 'ar' ? 'موقع من إنجازنا' : locale === 'en' ? 'Site built by DESORA' : 'Site signé DESORA';

const copies = [
  { items: clients, hidden: false },
  { items: clients, hidden: true },
];
---

<section
  class="relative overflow-hidden border-y border-border bg-bg-secondary py-14 sm:py-16"
  aria-labelledby="client-wall-heading"
>
  <div class="relative mx-auto mb-10 flex max-w-7xl flex-col gap-3 px-5 sm:flex-row sm:items-baseline sm:justify-between sm:px-8">
    <h2 id="client-wall-heading" class="label-caps">{heading}</h2>
    {note && <p class="text-sm text-text-secondary">{note}</p>}
  </div>

  <div class="edge-fade relative overflow-hidden" data-marquee="46" data-marquee-copies="2" data-logo-wall>
    <div class="logo-wall flex w-max items-center" data-marquee-track>
      {
        copies.map((copy) =>
          copy.items.map((client) => {
            const Cell = client.href ? 'a' : 'div';
            return (
              <Cell
                class:list={[
                  'logo-cell group/logo relative w-[10.5rem] shrink-0 sm:w-[13rem]',
                  client.tile && 'logo-cell--tile',
                ]}
                data-logo-cell
                style={`--logo-src:url('${client.ink}')`}
                aria-hidden={copy.hidden ? 'true' : undefined}
                tabindex={copy.hidden ? -1 : undefined}
                {...(client.href && !copy.hidden
                  ? { href: client.href, target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                <span class="logo-ink" aria-hidden="true" />
                <img
                  class="logo-color"
                  src={client.color}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  width="460"
                  height="190"
                />
                {!copy.hidden && (
                  <span class="sr-only">
                    {client.name}, {client.sector[locale]}
                  </span>
                )}
                {client.builtByDesora && (
                  <span
                    class="pointer-events-none absolute end-4 top-2 h-1.5 w-1.5 rounded-full bg-gold opacity-0 transition-opacity duration-500 group-hover/logo:opacity-100"
                    title={builtLabel}
                    aria-hidden="true"
                  />
                )}
              </Cell>
            );
          })
        )
      }
    </div>
  </div>

  <p class="relative mx-auto mt-8 flex max-w-7xl items-center gap-2 px-5 text-xs text-text-secondary sm:px-8">
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-gold" aria-hidden="true"></span>
    {builtLabel}
  </p>
</section>

<style>
  /* Attention is a spotlight: hovering one mark dims the rest of the strip so
     the eye lands where the cursor is. The marquee itself pauses on hover,
     handled in motion.ts. */
  .logo-wall:hover .logo-cell {
    opacity: 0.3;
  }
  .logo-wall .logo-cell:hover,
  .logo-wall .logo-cell:focus-visible {
    opacity: 1;
  }
  .logo-cell {
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: none) {
    /* Touch has no hover to reveal colour with, so every mark simply shows in
       its own colours and the ink layer stays out of the way. */
    .logo-wall:hover .logo-cell {
      opacity: 1;
    }
    .logo-ink {
      opacity: 0;
    }
    .logo-color {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-cell {
      transition-duration: 0.01ms;
    }
  }
</style>
