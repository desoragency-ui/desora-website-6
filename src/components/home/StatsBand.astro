---
interface Props {
  heading: string;
  items: { value: string; label: string }[];
}

const { heading, items } = Astro.props;

// Three copies so the loop is seamless (animate 0 -> -33.3334%).
// Only the first copy is exposed to assistive tech; the rest repeat visually.
const copies = [
  { items, hidden: false },
  { items, hidden: true },
  { items, hidden: true },
];
---

<section
  class="border-y border-border bg-bg-secondary py-14"
  aria-label={heading}
>
  <p class="overline mx-auto mb-8 max-w-7xl px-5 text-center sm:px-8">
    {heading}
  </p>

  <div
    class="marquee group relative overflow-hidden [-webkit-mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)] [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]"
  >
    <div class="marquee-track flex w-max items-center">
      {
        copies.map((copy) => (
          <div
            class="flex shrink-0 items-center"
            aria-hidden={copy.hidden ? 'true' : undefined}
          >
            {copy.items.map((item) => (
              <div class="flex shrink-0 items-center">
                <div class="flex shrink-0 items-baseline gap-3 px-8 sm:px-10">
                  <span class="numeral text-[clamp(2rem,3.5vw,2.9rem)] leading-none text-accent">
                    {item.value}
                  </span>
                  <span class="whitespace-nowrap text-sm text-text-secondary">
                    {item.label}
                  </span>
                </div>
                <span class="select-none text-xs text-gold/70" aria-hidden="true">
                  &#9670;
                </span>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marquee-track {
    /* One copy per cycle, so duration scales with item count to hold a constant
       reading speed: 15 items at ~9.6s each. */
    animation: marquee-move 144s linear infinite;
    will-change: transform;
  }

  /* Pause the scroll while the reader hovers to read a value. */
  .group:hover .marquee-track {
    animation-play-state: paused;
  }

  /* Right-to-left flow: the track slides leftward. */
  @keyframes marquee-move {
    from {
      transform: translateX(0%);
    }
    to {
      transform: translateX(-33.3334%);
    }
  }

  /* Arabic reads the other way, so mirror the direction. */
  :global(html[dir='rtl']) .marquee-track {
    animation-direction: reverse;
  }

  /* No motion: hold everything still, centered and wrapped so nothing clips. */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
    }
    .marquee-track > [aria-hidden='true'] {
      display: none;
    }
  }
</style>
