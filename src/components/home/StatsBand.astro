---
interface Props {
  heading: string;
  items: { value: string; label: string }[];
}

const { heading, items } = Astro.props;
---

<section class="border-y border-border bg-bg-secondary py-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <h2 class="overline text-center">{heading}</h2>
    <div class="mt-12 grid grid-cols-2 gap-y-10 lg:grid-cols-4" data-reveal-group>
      {
        items.map((item, i) => (
          <div
            class:list={[
              'min-w-0 px-4 text-center',
              i > 0 && 'lg:border-s lg:border-hairline',
            ]}
          >
            <p class="numeral text-[clamp(2.75rem,5vw,4rem)] leading-none text-accent break-words">{item.value}</p>
            <p class="mt-3 text-sm text-text-secondary">{item.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
