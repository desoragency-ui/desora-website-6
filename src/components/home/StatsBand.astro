---
/**
 * The numbers band.
 *
 * Driven by `initMarquees` in src/scripts/motion.ts rather than a CSS keyframe.
 * Two wins over the keyframe version it replaces: the strip surges with scroll
 * velocity, so the band feels physically connected to the page instead of
 * looping on its own clock, and it works under RTL without a second mirrored
 * keyframe.
 *
 * Two copies, because that is what the script's wrap maths expects. Only the
 * first is exposed to assistive tech; the second is a visual repeat.
 */
interface Props {
  heading: string;
  items: { value: string; label: string }[];
}

const { heading, items } = Astro.props;
const copies = [
  { items, hidden: false },
  { items, hidden: true },
];
---

<section class="relative overflow-hidden border-y border-border bg-bg-secondary py-16" aria-label={heading}>
  <div class="rule-grid" aria-hidden="true"></div>

  <p class="overline relative mx-auto mb-10 max-w-7xl px-5 text-center sm:px-8">{heading}</p>

  <div class="edge-fade relative overflow-hidden" data-marquee="72" data-marquee-copies="2">
    <div class="flex w-max items-center" data-marquee-track>
      {
        copies.map((copy) => (
          <div class="flex shrink-0 items-center" aria-hidden={copy.hidden ? 'true' : undefined}>
            {copy.items.map((item) => (
              <div class="flex shrink-0 items-center">
                <div class="flex shrink-0 items-baseline gap-3 px-8 sm:px-10">
                  <span class="numeral text-[clamp(2rem,3.5vw,2.9rem)] leading-none text-accent">
                    {item.value}
                  </span>
                  <span class="whitespace-nowrap text-sm text-text-secondary">{item.label}</span>
                </div>
                <span class="h-1.5 w-1.5 shrink-0 rotate-45 bg-gold/70" aria-hidden="true" />
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
