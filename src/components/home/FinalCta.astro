---
import Icon from '../Icon.astro';
import BrandPattern from '../BrandPattern.astro';
import { useTranslations, localizedPath } from '../../i18n/utils';
import { siteConfig } from '../../lib/site-config';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  heading: string;
  description: string;
}

const { locale, heading, description } = Astro.props;
const t = useTranslations(locale);
---

<section class="mx-auto max-w-7xl px-5 py-24 sm:px-8">
  <div class="relative overflow-hidden rounded-[2rem] bg-accent px-8 py-20 text-center sm:px-16" data-reveal>
    <BrandPattern tone="contrast" opacity={0.06} />
    <div class="relative">
    <h2 class="font-display text-[clamp(2.25rem,4.5vw,3.5rem)] font-semibold leading-[1.05] text-accent-foreground">
      {heading}
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-accent-foreground/80">{description}</p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
      <a
        href={localizedPath(locale, 'contact')}
        class="flex h-13 items-center rounded-full bg-accent-foreground px-7 text-base font-semibold text-accent transition-transform hover:scale-[1.03]"
      >
        {t('cta.discussProject')}
      </a>
      <a
        href={siteConfig.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex h-13 items-center gap-2 rounded-full border border-accent-foreground/40 px-7 text-base font-semibold text-accent-foreground transition-colors hover:border-accent-foreground"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
        {t('cta.whatsapp')}
      </a>
    </div>
    </div>
  </div>
</section>
