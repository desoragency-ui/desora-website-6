---
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import Wordmark from './Wordmark.astro';
import BrandPattern from './BrandPattern.astro';

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
---

<div
  id="preloader"
  class="fixed inset-0 z-100 flex flex-col items-center justify-center overflow-hidden bg-bg-primary"
  role="status"
  aria-live="polite"
  aria-label={t('preloader.loading')}
>
  <BrandPattern opacity={0.03} />
  <div id="preloader-inner" class="relative flex flex-col items-center gap-8">
    <Wordmark class="h-12 text-5xl sm:h-16 sm:text-6xl" />
    <div id="preloader-rule" class="hairline w-16 origin-left opacity-60"></div>
    <span
      id="preloader-count"
      class="numeral text-[clamp(4rem,13vw,8rem)] leading-none text-text-primary"
    >
      0
    </span>
  </div>
  <!-- Curtain: rises to reveal the page, rather than the whole screen fading. -->
  <div id="preloader-curtain" class="pointer-events-none absolute inset-0 z-10 origin-bottom bg-bg-primary" style="transform: scaleY(0);"></div>
</div>

<script>
  import { gsap } from 'gsap';

  const preloader = document.getElementById('preloader');
  const counter = document.getElementById('preloader-count');
  const skip = document.documentElement.classList.contains('preloader-skip');

  function finish() {
    try {
      sessionStorage.setItem('desora-preloader-shown', '1');
    } catch (e) {
      /* ignore */
    }
    // Set a synchronous flag in addition to the event: scripts further down
    // the page (e.g. Hero) may still be loading/importing modules (like
    // gsap) when this fires, and would otherwise miss a one-shot event
    // dispatched before they've registered their listener.
    (window as any).__desoraPreloaderDone = true;
    window.dispatchEvent(new CustomEvent('desora:preloader-done'));
  }

  if (!preloader || skip) {
    finish();
  } else {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      preloader.style.display = 'none';
      finish();
    } else {
      document.body.classList.add('overflow-hidden');
      const counterState = { value: 0 };
      const inner = document.getElementById('preloader-inner');
      const rule = document.getElementById('preloader-rule');
      const curtain = document.getElementById('preloader-curtain');

      const tl = gsap.timeline({
        onComplete: () => {
          preloader.style.display = 'none';
          document.body.classList.remove('overflow-hidden');
          finish();
        },
      });

      // The rule draws itself out under the wordmark as the count climbs.
      if (rule) tl.fromTo(rule, { scaleX: 0 }, { scaleX: 1, duration: 1.6, ease: 'power2.inOut' }, 0);

      tl.to(
        counterState,
        {
          value: 100,
          duration: 1.6,
          ease: 'power2.inOut',
          onUpdate: () => {
            if (counter) counter.textContent = String(Math.round(counterState.value));
          },
        },
        0
      );

      // Wordmark and count lift away, then the curtain rises off the page.
      if (inner) tl.to(inner, { opacity: 0, y: -24, duration: 0.6, ease: 'power2.in' }, '+=0.2');
      if (curtain) {
        tl.set(curtain, { scaleY: 1, transformOrigin: 'bottom center' })
          .set(preloader, { backgroundColor: 'transparent' })
          .to(curtain, { scaleY: 0, duration: 1, ease: 'power3.inOut', transformOrigin: 'top center' });
      } else {
        tl.to(preloader, { opacity: 0, duration: 0.6, ease: 'power1.out' });
      }
    }
  }
</script>
