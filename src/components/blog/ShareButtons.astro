---
import Icon from '../Icon.astro';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  title: string;
}

const { locale, title } = Astro.props;
const t = useTranslations(locale);
const pageUrl = Astro.url.toString();

const links = [
  { name: 'whatsapp', href: `https://wa.me/?text=${encodeURIComponent(`${title} ${pageUrl}`)}` },
  { name: 'linkedin', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}` },
  { name: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}` },
];
---

<div class="flex items-center gap-3">
  <span class="text-sm font-medium text-text-secondary">{t('blog.share')}</span>
  {
    links.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-border text-text-primary transition-colors hover:border-accent hover:text-accent"
        aria-label={link.name}
      >
        <Icon name={link.name as any} class="h-4 w-4" />
      </a>
    ))
  }
</div>
