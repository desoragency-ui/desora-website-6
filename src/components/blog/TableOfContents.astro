---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  locale: Locale;
  headings: Heading[];
}

const { locale, headings } = Astro.props;
const t = useTranslations(locale);
const topLevel = headings.filter((h) => h.depth <= 2);
---

{
  topLevel.length > 0 && (
    <nav class="sticky top-28 hidden rounded-2xl border border-border bg-surface p-6 lg:block" aria-label={t('blog.tableOfContents')}>
      <p class="font-display text-sm font-semibold text-text-primary">{t('blog.tableOfContents')}</p>
      <ul class="mt-4 space-y-2.5 border-s border-border ps-4 text-sm">
        {topLevel.map((h) => (
          <li>
            <a href={`#${h.slug}`} class="text-text-secondary hover:text-accent">
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
