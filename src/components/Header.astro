---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, localizedPath } from '../i18n/utils';
import { getServices } from '../lib/content';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const services = await getServices(locale);

const navLinks = [
  { href: localizedPath(locale, ''), label: t('nav.home') },
  { href: localizedPath(locale, 'a-propos'), label: t('nav.about') },
  { href: localizedPath(locale, 'blog'), label: t('nav.blog') },
  { href: localizedPath(locale, 'contact'), label: t('nav.contact') },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 w-full border-b border-transparent transition-colors duration-300 data-[scrolled=true]:border-border data-[scrolled=true]:bg-bg-primary/90 data-[scrolled=true]:backdrop-blur-md"
  data-scrolled="false"
>
  <div class="mx-auto flex h-20 w-full max-w-7xl items-center justify-between px-5 sm:px-8">
    <a href={localizedPath(locale, '')} aria-label="DESORA" class="transition-opacity hover:opacity-80">
      <Wordmark class="h-6 text-2xl" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigation principale">
      <a href={navLinks[0].href} class="rounded-full px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:bg-bg-secondary">
        {navLinks[0].label}
      </a>
      <a href={navLinks[1].href} class="rounded-full px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:bg-bg-secondary">
        {navLinks[1].label}
      </a>

      <div class="group relative">
        <button
          type="button"
          class="flex items-center gap-1 rounded-full px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:bg-bg-secondary"
          aria-haspopup="true"
          id="services-menu-trigger"
        >
          {t('nav.services')}
          <Icon name="chevron-down" class="h-3.5 w-3.5 transition-transform group-[&.is-open]:rotate-180" />
        </button>
        <div
          id="services-menu"
          class="invisible absolute start-0 top-full z-50 mt-2 w-80 -translate-y-1 rounded-2xl border border-border bg-surface p-2 opacity-0 shadow-xl transition-all duration-150 [&.is-open]:visible [&.is-open]:translate-y-0 [&.is-open]:opacity-100"
        >
          {
            services.map((service) => (
              <a
                href={localizedPath(locale, `services/${service.slug}`)}
                class="flex items-start gap-3 rounded-xl p-3 transition-colors hover:bg-bg-secondary"
              >
                <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-bg-secondary text-accent">
                  <Icon name={service.icon as any} class="h-4.5 w-4.5" />
                </span>
                <span>
                  <span class="block text-sm font-semibold text-text-primary">{service.title}</span>
                  <span class="block text-xs text-text-secondary">{service.tagline}</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <a href={navLinks[2].href} class="rounded-full px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:bg-bg-secondary">
        {navLinks[2].label}
      </a>
      <a href={navLinks[3].href} class="rounded-full px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:bg-bg-secondary">
        {navLinks[3].label}
      </a>
    </nav>

    <div class="hidden items-center gap-1 lg:flex">
      <LanguageSwitcher locale={locale} />
      <ThemeToggle locale={locale} />
      <a
        href={localizedPath(locale, 'contact')}
        class="ms-2 flex h-11 items-center rounded-full bg-accent px-5 text-sm font-semibold text-accent-foreground transition-colors hover:bg-accent-hover"
      >
        {t('nav.cta')}
      </a>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <ThemeToggle locale={locale} />
      <button
        type="button"
        id="mobile-menu-trigger"
        class="flex h-11 w-11 items-center justify-center rounded-full text-text-primary hover:bg-bg-secondary"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="fixed inset-0 top-20 z-40 hidden overflow-y-auto bg-bg-primary px-5 pb-10 pt-4 lg:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="Navigation mobile">
      {
        navLinks.slice(0, 2).map((link) => (
          <a href={link.href} class="rounded-xl px-4 py-3 text-base font-medium text-text-primary hover:bg-bg-secondary">
            {link.label}
          </a>
        ))
      }
      <p class="px-4 pb-1 pt-4 text-xs font-semibold uppercase tracking-wide text-text-secondary">
        {t('nav.services')}
      </p>
      {
        services.map((service) => (
          <a
            href={localizedPath(locale, `services/${service.slug}`)}
            class="rounded-xl px-4 py-3 text-base font-medium text-text-primary hover:bg-bg-secondary"
          >
            {service.title}
          </a>
        ))
      }
      <div class="my-2 h-px bg-border" />
      {
        navLinks.slice(2).map((link) => (
          <a href={link.href} class="rounded-xl px-4 py-3 text-base font-medium text-text-primary hover:bg-bg-secondary">
            {link.label}
          </a>
        ))
      }
      <div class="mt-4 flex items-center justify-between px-4">
        <LanguageSwitcher locale={locale} />
      </div>
      <a
        href={localizedPath(locale, 'contact')}
        class="mt-4 flex h-12 items-center justify-center rounded-full bg-accent px-5 text-base font-semibold text-accent-foreground"
      >
        {t('nav.cta')}
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => {
    header?.setAttribute('data-scrolled', String(window.scrollY > 8));
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const servicesTrigger = document.getElementById('services-menu-trigger');
  const servicesMenu = document.getElementById('services-menu');
  servicesTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    servicesMenu?.classList.toggle('is-open');
    servicesTrigger.parentElement?.classList.toggle('is-open');
  });
  document.addEventListener('click', (e) => {
    if (servicesTrigger && servicesMenu && !servicesTrigger.parentElement?.contains(e.target as Node)) {
      servicesMenu.classList.remove('is-open');
      servicesTrigger.parentElement?.classList.remove('is-open');
    }
  });

  const mobileTrigger = document.getElementById('mobile-menu-trigger');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileTrigger?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    document.body.classList.toggle('overflow-hidden', Boolean(isHidden));
    mobileTrigger.setAttribute('aria-expanded', String(Boolean(isHidden)));
  });
  mobileMenu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      mobileTrigger?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
