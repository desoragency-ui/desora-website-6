---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, localizedPath } from '../i18n/utils';
import { getServices } from '../lib/content';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const services = await getServices(locale);

const navLinks = [
  { href: localizedPath(locale, ''), label: t('nav.home') },
  { href: localizedPath(locale, 'a-propos'), label: t('nav.about') },
  { href: localizedPath(locale, 'blog'), label: t('nav.blog') },
  { href: localizedPath(locale, 'contact'), label: t('nav.contact') },
];
---

<!-- Floating island. A bar welded to the top edge is the most template-like
     thing a site can do, so the header is detached from every edge and rounded
     into a capsule: an object above the page rather than a strip stuck to it.
     The glass and the ring intensify once the page has scrolled under it. -->
<header
  id="site-header"
  class="pointer-events-none fixed inset-x-0 top-0 z-50 w-full px-3 pt-3 transition-[padding] duration-700 [transition-timing-function:cubic-bezier(0.32,0.72,0,1)] sm:px-5 sm:pt-5 data-[scrolled=true]:pt-2 sm:data-[scrolled=true]:pt-3"
  data-scrolled="false"
>
  <div
    id="header-inner"
    class="island pointer-events-auto mx-auto flex h-[4.25rem] w-full max-w-7xl items-center justify-between pe-2 ps-5 transition-[height] duration-700 [transition-timing-function:cubic-bezier(0.32,0.72,0,1)] sm:pe-3 sm:ps-7 [header[data-scrolled=true]_&]:h-[3.75rem]"
  >
    <a
      href={localizedPath(locale, '')}
      aria-label="DESORA"
      class="transition-opacity duration-500 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)] hover:opacity-70"
    >
      <Wordmark class="h-9 text-3xl sm:h-11 sm:text-4xl" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigation principale">
      <a href={navLinks[0].href} class="group relative px-4 py-2 text-sm font-medium text-text-primary transition-colors duration-500 hover:text-accent">
        {navLinks[0].label}
        <span class="pointer-events-none absolute inset-x-4 bottom-1 h-px origin-left scale-x-0 bg-gold transition-transform duration-500 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)] group-hover:scale-x-100 rtl:origin-right"></span>
      </a>
      <a href={navLinks[1].href} class="group relative px-4 py-2 text-sm font-medium text-text-primary transition-colors duration-500 hover:text-accent">
        {navLinks[1].label}
        <span class="pointer-events-none absolute inset-x-4 bottom-1 h-px origin-left scale-x-0 bg-gold transition-transform duration-500 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)] group-hover:scale-x-100 rtl:origin-right"></span>
      </a>

      <div class="group relative">
        <button
          type="button"
          class="group relative flex items-center gap-1 px-4 py-2 text-sm font-medium text-text-primary transition-colors duration-500 hover:text-accent"
          aria-haspopup="true"
          id="services-menu-trigger"
        >
          {t('nav.services')}
          <Icon name="chevron-down" class="h-3.5 w-3.5 transition-transform duration-500 group-[&.is-open]:rotate-180" />
          <span class="pointer-events-none absolute inset-x-4 bottom-1 h-px origin-left scale-x-0 bg-gold transition-transform duration-500 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)] group-hover:scale-x-100 rtl:origin-right"></span>
        </button>
        <div
          id="services-menu"
          class="absolute start-0 top-full z-50 mt-3 w-80 rounded-2xl border border-hairline bg-surface p-2 shadow-[0_24px_60px_-18px_var(--shadow-tint)]"
        >
          {
            services.map((service) => (
              <a
                href={localizedPath(locale, `services/${service.slug}`)}
                class="group/item flex items-start gap-3 rounded-xl p-3 transition-colors duration-300 hover:bg-bg-secondary"
              >
                <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-bg-secondary text-accent transition-colors duration-300 group-hover/item:bg-accent-strong group-hover/item:text-accent-foreground">
                  <Icon name={service.icon as any} class="h-4.5 w-4.5" />
                </span>
                <span>
                  <span class="block text-sm font-semibold text-text-primary">{service.title}</span>
                  <span class="block text-xs text-text-secondary">{service.tagline}</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <a href={navLinks[2].href} class="group relative px-4 py-2 text-sm font-medium text-text-primary transition-colors duration-500 hover:text-accent">
        {navLinks[2].label}
        <span class="pointer-events-none absolute inset-x-4 bottom-1 h-px origin-left scale-x-0 bg-gold transition-transform duration-500 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)] group-hover:scale-x-100 rtl:origin-right"></span>
      </a>
      <a href={navLinks[3].href} class="group relative px-4 py-2 text-sm font-medium text-text-primary transition-colors duration-500 hover:text-accent">
        {navLinks[3].label}
        <span class="pointer-events-none absolute inset-x-4 bottom-1 h-px origin-left scale-x-0 bg-gold transition-transform duration-500 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)] group-hover:scale-x-100 rtl:origin-right"></span>
      </a>
    </nav>

    <div class="hidden items-center gap-1 lg:flex">
      <LanguageSwitcher locale={locale} />
      <ThemeToggle locale={locale} />
      <a
        href={localizedPath(locale, 'contact')}
        class="btn-lux btn-lux--fill cta-shine ms-2 !h-11 !ps-5 text-sm"
      >
        <span>{t('nav.cta')}</span>
        <span class="btn-lux__well !h-8 !w-8">
          <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
        </span>
      </a>
    </div>

    <!-- Mobile controls. The language switcher lives HERE, in the bar, not
         inside the menu panel: buried in the panel it was unreachable without
         first opening the menu, and its dropdown was clipped by the panel's
         own scroll container. -->
    <div class="flex items-center gap-1 lg:hidden" data-no-entrance>
      <LanguageSwitcher locale={locale} compact />
      <ThemeToggle locale={locale} />
      <button
        type="button"
        id="mobile-menu-trigger"
        class="flex h-11 w-11 items-center justify-center rounded-full text-text-primary hover:bg-bg-secondary"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="burger" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Sibling of <header>, NOT a child: once scrolled, the header gets a
     backdrop-filter, and a filtered ancestor makes position:fixed descendants
     anchor to it instead of the viewport, which collapsed this panel when open
     after any scroll. Kept outside so it always covers the real viewport. -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 overflow-y-auto bg-bg-primary/98 px-5 pb-10 pt-24 backdrop-blur-xl lg:hidden"
>
    <nav class="flex flex-col gap-1" aria-label="Navigation mobile">
      {
        navLinks.slice(0, 2).map((link) => (
          <a href={link.href} class="rounded-xl px-4 py-3 text-base font-medium text-text-primary hover:bg-bg-secondary">
            {link.label}
          </a>
        ))
      }
      <p class="px-4 pb-1 pt-4 text-xs font-semibold uppercase tracking-wide text-text-secondary">
        {t('nav.services')}
      </p>
      {
        services.map((service) => (
          <a
            href={localizedPath(locale, `services/${service.slug}`)}
            class="rounded-xl px-4 py-3 text-base font-medium text-text-primary hover:bg-bg-secondary"
          >
            {service.title}
          </a>
        ))
      }
      <div class="hairline my-3" />
      {
        navLinks.slice(2).map((link) => (
          <a href={link.href} class="rounded-xl px-4 py-3 text-base font-medium text-text-primary hover:bg-bg-secondary">
            {link.label}
          </a>
        ))
      }
      <a
        href={localizedPath(locale, 'contact')}
        class="btn-lux btn-lux--fill cta-shine mt-6 w-full justify-between"
      >
        <span>{t('nav.cta')}</span>
        <span class="btn-lux__well">
          <Icon name="arrow-up-right" class="h-4 w-4" />
        </span>
      </a>
    </nav>
  </div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { reduceMotion, lenis } from '../scripts/motion';

  gsap.registerPlugin(ScrollTrigger);

  const header = document.getElementById('site-header');

  // Scrolled state via ScrollTrigger rather than a raw scroll listener, so it
  // rides the same rAF loop as Lenis instead of firing on every scroll event.
  if (header) {
    ScrollTrigger.create({
      start: 'top -8',
      end: 99999,
      onUpdate: (self) => header.setAttribute('data-scrolled', String(self.scroll() > 8)),
      onToggle: (self) => header.setAttribute('data-scrolled', String(self.isActive)),
    });
    header.setAttribute('data-scrolled', String(window.scrollY > 8));
  }

  // Header settles in after the preloader clears, so the wordmark isn't
  // already sitting there when the curtain lifts.
  function playHeaderEntrance() {
    if (reduceMotion || !header) return;

    // The mobile control cluster is deliberately EXCLUDED from the entrance.
    // Animating it means starting it at opacity 0, and anything that stops the
    // rAF loop before the tween finishes (a page loaded in a background tab, a
    // prerender, a stalled main thread) leaves the language, theme and menu
    // buttons invisible and unclickable. Decorative elements may fade in;
    // controls are visible from first paint, always.
    const items = header.querySelectorAll('#header-inner > *:not([data-no-entrance])');
    if (!items.length) return;

    const tl = gsap.fromTo(
      items,
      { opacity: 0, y: -14 },
      { opacity: 1, y: 0, duration: 0.9, stagger: 0.08, ease: 'power3.out', clearProps: 'transform' }
    );

    // Watchdog. setTimeout keeps running when rAF is throttled, so a header
    // that never got its frames still ends up visible rather than stuck at 0.
    window.setTimeout(() => {
      if (!tl.progress || tl.progress() < 1) gsap.set(items, { opacity: 1, y: 0, clearProps: 'transform' });
    }, 2600);
  }

  if ((window as any).__desoraPreloaderDone || document.documentElement.classList.contains('preloader-skip')) {
    playHeaderEntrance();
  } else {
    window.addEventListener('desora:preloader-done', playHeaderEntrance, { once: true });
  }

  const servicesTrigger = document.getElementById('services-menu-trigger');
  const servicesMenu = document.getElementById('services-menu');
  servicesTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    servicesMenu?.classList.toggle('is-open');
    servicesTrigger.parentElement?.classList.toggle('is-open');
  });
  document.addEventListener('click', (e) => {
    if (servicesTrigger && servicesMenu && !servicesTrigger.parentElement?.contains(e.target as Node)) {
      servicesMenu.classList.remove('is-open');
      servicesTrigger.parentElement?.classList.remove('is-open');
    }
  });

  const mobileTrigger = document.getElementById('mobile-menu-trigger');
  const mobileMenu = document.getElementById('mobile-menu');

  function setMobileMenu(open: boolean) {
    if (!mobileMenu) return;
    mobileMenu.classList.toggle('is-open', open);
    document.body.classList.toggle('overflow-hidden', open);
    mobileTrigger?.setAttribute('aria-expanded', String(open));
    // overflow-hidden alone doesn't halt Lenis, so the page kept scrolling
    // behind the open panel. Pause the smooth-scroll instance while it's open.
    if (open) lenis?.stop();
    else lenis?.start();

    if (open && !reduceMotion) {
      // Links cascade in behind the panel fade.
      gsap.fromTo(
        mobileMenu.querySelectorAll('nav > *'),
        { opacity: 0, y: 12 },
        { opacity: 1, y: 0, duration: 0.5, stagger: 0.035, ease: 'power3.out', delay: 0.12, clearProps: 'all' }
      );
    }
  }

  mobileTrigger?.addEventListener('click', () => {
    setMobileMenu(!mobileMenu?.classList.contains('is-open'));
  });
  mobileMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMobileMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu?.classList.contains('is-open')) setMobileMenu(false);
  });
</script>
