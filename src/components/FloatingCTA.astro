---
import Icon from './Icon.astro';
import { useTranslations, localizedPath } from '../i18n/utils';
import { siteConfig } from '../lib/site-config';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const whatsappMessage = locale === 'ar' ? 'مرحبًا، أرغب في مناقشة مشروعي' : locale === 'en' ? "Hi, I'd like to discuss my project" : 'Bonjour, je souhaite discuter de mon projet';
---

<div
  id="floating-cta"
  class="fixed bottom-6 end-6 z-40 flex translate-y-4 flex-col items-end gap-3 opacity-0 transition-all duration-300 [&.is-visible]:translate-y-0 [&.is-visible]:opacity-100"
>
  <a
    href={localizedPath(locale, 'contact')}
    class="press hidden h-11 items-center rounded-full border border-hairline bg-surface px-4 text-sm font-medium text-text-primary shadow-[0_10px_30px_-12px_var(--shadow-tint)] transition-colors duration-500 hover:border-accent hover:text-accent sm:flex"
  >
    {t('cta.discuss')}
  </a>
  <a
    href={siteConfig.whatsappUrlWithMessage(whatsappMessage)}
    target="_blank"
    rel="noopener noreferrer"
    class="press flex h-14 w-14 items-center justify-center rounded-full bg-accent-strong text-accent-foreground shadow-[0_14px_36px_-10px_var(--shadow-tint)] transition-transform duration-500 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)] hover:scale-110"
    aria-label={t('cta.whatsapp')}
  >
    <Icon name="whatsapp" class="h-6 w-6" />
  </a>
</div>

<script>
  const el = document.getElementById('floating-cta');
  if (el) {
    const threshold = () => window.innerHeight * 0.6;
    const onScroll = () => {
      el.classList.toggle('is-visible', window.scrollY > threshold());
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
