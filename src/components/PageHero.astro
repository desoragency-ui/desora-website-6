---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="relative overflow-hidden px-5 pb-16 pt-36 sm:px-8">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute -left-[10%] top-[-15%] h-[38vw] w-[38vw] max-h-[480px] max-w-[480px] rounded-full bg-accent/12 blur-[110px]"></div>
  </div>
  <div class="mx-auto max-w-3xl text-center" data-reveal>
    <h1 class="font-display text-[clamp(2.25rem,5.5vw,3.75rem)] font-semibold leading-[1.1] tracking-tight text-text-primary">
      {title}
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-[clamp(1.05rem,1.8vw,1.2rem)] leading-relaxed text-text-secondary">
      {subtitle}
    </p>
  </div>
</section>
