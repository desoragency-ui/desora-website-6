---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

/**
 * One real client quote, tied to the service the client actually bought.
 * Shares the blockquote treatment used by ServiceCaseStudy so the two blocks
 * read as one system when a page carries both.
 */
interface Props {
  locale: Locale;
  testimonial?: { quote: string; author: string; role: string };
}

const { locale, testimonial } = Astro.props;
const t = useTranslations(locale);
---

{
  testimonial && (
    <section class="mx-auto max-w-5xl px-5 py-16 sm:px-8">
      <p class="overline" data-reveal>
        {t('testimonial.label')}
      </p>
      <blockquote class="bezel mt-5" data-reveal><div class="bezel-core p-8">
        <p class="font-display text-[clamp(1.15rem,2vw,1.5rem)] leading-snug text-text-primary">"{testimonial.quote}"</p>
        <footer class="mt-5 text-base">
          <p class="font-semibold text-text-primary">{testimonial.author}</p>
          <p class="text-text-secondary">{testimonial.role}</p>
        </footer>
      </div></blockquote>
    </section>
  )
}
