---
import Icon from '../Icon.astro';
import { useTranslations, localizedPath } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

/**
 * The three service packs, as an editorial plate rather than a SaaS pricing
 * table. Each tier is numbered like a chapter, ruled off with gold hairlines,
 * and the recommended tier is raised on a tinted surface instead of shouting
 * with a coloured banner. No prices, by brand policy.
 *
 * Everything is written with logical properties (ps/pe, start/end, inset-inline)
 * so the Arabic RTL build mirrors without a single override.
 */
interface Props {
  locale: Locale;
  pricing: {
    essentiel: { features: string[] };
    croissance: { features: string[] };
    signature: { features: string[] };
  };
}

const { locale, pricing } = Astro.props;
const t = useTranslations(locale);

const tiers = [
  {
    key: 'essentiel',
    index: '01',
    name: t('pricing.essential'),
    features: pricing.essentiel.features,
    previousTierName: null,
    recommended: false,
  },
  {
    key: 'croissance',
    index: '02',
    name: t('pricing.growth'),
    features: pricing.croissance.features,
    previousTierName: t('pricing.essential'),
    recommended: true,
  },
  {
    key: 'signature',
    index: '03',
    name: t('pricing.signature'),
    features: pricing.signature.features,
    previousTierName: t('pricing.growth'),
    recommended: false,
  },
];
---

<section class="relative overflow-hidden bg-bg-secondary py-24 sm:py-28" data-depth>
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-2xl" data-reveal>
      <p class="overline">{t('pricing.overline')}</p>
      <h2
        class="mt-4 font-display text-[clamp(2rem,4vw,3.25rem)] font-semibold leading-[1.08] text-text-primary"
      >
        {t('pricing.heading')}
      </h2>
      <span class="hairline mt-6 block max-w-24"></span>
    </div>

    <div class="mt-14 grid grid-cols-1 items-stretch gap-6 lg:grid-cols-3 lg:gap-7" data-reveal-group data-skew>
      {
        tiers.map((tier) => (
          <article
            class:list={[
              'tier bezel group relative flex h-full flex-col',
              'transition-[transform,border-color,box-shadow] duration-500 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)]',
              tier.recommended
                ? 'tier--featured lg:-translate-y-5 [&>.bezel-core]:shadow-[inset_0_0_0_1px_color-mix(in_oklab,var(--color-gold)_45%,transparent)]'
                : 'bezel--interactive',
            ]}
          >
            <div class="bezel-core flex h-full flex-col p-8 sm:p-9">
            {/* Chapter number, sitting in the corner like a plate mark. */}
            <div class="flex items-baseline justify-between gap-4">
              <span class="numeral text-3xl leading-none text-gold/70">{tier.index}</span>
              {tier.recommended && (
                <span class="eyebrow">
                  {t('pricing.recommended')}
                </span>
              )}
            </div>

            <h3
              class:list={[
                'mt-6 font-display text-[clamp(2rem,3vw,2.6rem)] font-semibold leading-none tracking-[0.01em]',
                tier.recommended ? 'text-accent' : 'text-text-primary',
              ]}
            >
              {tier.name}
            </h3>

            <span class="hairline mt-6 block"></span>

            {tier.previousTierName && (
              <p class="mt-6 text-base font-medium leading-snug text-text-secondary">
                {t('pricing.everythingIn', { tier: tier.previousTierName })}
              </p>
            )}

            <ul class:list={['flex-1 space-y-4', tier.previousTierName ? 'mt-5' : 'mt-7']}>
              {tier.features.map((feature) => (
                <li class="flex items-start gap-3 text-base leading-snug text-text-primary">
                  <span
                    class="mt-[0.45em] shrink-0 text-[0.6rem] leading-none text-gold"
                    aria-hidden="true"
                  >
                    &#9670;
                  </span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <a
              href={localizedPath(locale, 'contact')}
              class:list={[
                'btn-lux mt-10 w-full justify-between',
                'transition-all duration-500 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)]',
                tier.recommended
                  ? 'cta-shine bg-accent-strong text-accent-foreground hover:bg-accent-strong-hover'
                  : 'btn-lux--ghost',
              ]}
            >
              <span>{t('cta.discussPack')}</span>
              <span class="btn-lux__well">
                <Icon name="arrow-right" class="h-4 w-4 rtl:rotate-180" />
              </span>
            </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* A whisper of warmth behind the recommended tier, so it reads as raised
     rather than as a different product. Kept as a pseudo-element to avoid
     paying for an extra DOM node in every card. */
  .tier--featured::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(120% 80% at 50% 0%, var(--color-gold), transparent 70%);
    opacity: 0.07;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tier {
      transition: none;
    }
  }
</style>
