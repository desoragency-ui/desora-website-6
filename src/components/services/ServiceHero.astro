---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import BrandPattern from '../BrandPattern.astro';
import { useTranslations, localizedPath } from '../../i18n/utils';
import { siteConfig } from '../../lib/site-config';
import { getServiceMedia } from '../../lib/media';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  icon: string;
  title: string;
  h1: string;
  slug: string;
}

const { locale, icon, title, h1, slug } = Astro.props;
const t = useTranslations(locale);
const image = getServiceMedia(slug);
---

<section class="bleed-hero flex min-h-[78svh] flex-col justify-center px-5 pb-20 pt-36 sm:px-8">
  {
    image && (
      <div class="bleed-media" aria-hidden="true">
        <Image
          class="service-hero-image"
          src={image}
          alt=""
          widths={[640, 960, 1280, 1600, 2048, 2752]}
          sizes="100vw"
          format="webp"
          quality={86}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      </div>
    )
  }
  <div class="bleed-scrim" aria-hidden="true"></div>
  <BrandPattern opacity={0.035} />

  <div class="bleed-content mx-auto w-full max-w-7xl">
    <div class="max-w-2xl" data-reveal>
      <div class="flex items-center gap-3 text-sm font-semibold uppercase tracking-wide text-accent">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/10">
          <Icon name={icon as any} class="h-4.5 w-4.5" />
        </span>
        {title}
      </div>
      <h1 class="mt-6 font-display text-[clamp(2.25rem,5.5vw,4rem)] font-semibold leading-[1.08] tracking-tight text-text-primary">
        {h1}
      </h1>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href={localizedPath(locale, 'contact')}
          class="cta-shine press flex h-13 items-center rounded-full bg-accent-strong px-7 text-base font-semibold text-accent-foreground transition-colors duration-500 hover:bg-accent-strong-hover"
        >
          {t('cta.discussProject')}
        </a>
        <a
          href={siteConfig.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="press flex h-13 items-center gap-2 rounded-full border border-border px-7 text-base font-semibold text-text-primary transition-all duration-500 [transition-timing-function:cubic-bezier(0.16,1,0.3,1)] hover:border-accent hover:bg-accent/5 hover:text-accent"
        >
          <Icon name="whatsapp" class="h-5 w-5" />
          {t('cta.whatsapp')}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { reduceMotion } from '../../scripts/motion';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector('.bleed-hero');
  const img = document.querySelector<HTMLElement>('.service-hero-image');

  if (img && section) {
    if (reduceMotion) {
      gsap.set(img, { opacity: 1, scale: 1 });
    } else {
      // Same aperture-open as the homepage: the plate settles out of an
      // over-scale and blur, then hands off to the slow ambient drift.
      gsap.fromTo(
        img,
        { opacity: 0, scale: 1.14, filter: 'blur(12px)' },
        {
          opacity: 1,
          scale: 1.02,
          filter: 'blur(0px)',
          duration: 1.7,
          ease: 'power3.out',
          onComplete: () => img.classList.add('is-drifting'),
        }
      );

      gsap.to(img, {
        yPercent: 10,
        ease: 'none',
        scrollTrigger: { trigger: section, start: 'top top', end: 'bottom top', scrub: 0.8 },
      });
    }
  }
</script>
