---
import { useTranslations } from '../../i18n/utils';
import { siteConfig } from '../../lib/site-config';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  services: { slug: string; title: string }[];
}

const { locale, services } = Astro.props;
const t = useTranslations(locale);
---

<form
  id="contact-form"
  class="space-y-5"
  method="POST"
  action={siteConfig.formEndpoint}
  data-endpoint={siteConfig.formEndpoint}
  data-whatsapp={siteConfig.whatsappUrl}
  data-label-submit={t('form.submit')}
  data-label-sending={t('form.sending')}
>
  {/* FormSubmit's own honeypot: bots fill it, humans never see it. */}
  <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <div>
    <label for="name" class="mb-2 block text-sm font-medium text-text-primary">{t('form.name')}</label>
    <input
      id="name"
      name="name"
      type="text"
      required
      class="h-12 w-full rounded-xl bg-[color-mix(in_oklab,var(--color-text-primary)_3%,transparent)] px-4 text-sm text-text-primary shadow-[inset_0_0_0_1px_color-mix(in_oklab,var(--color-text-primary)_11%,transparent)] outline-none transition-shadow duration-500 [transition-timing-function:cubic-bezier(0.32,0.72,0,1)] focus:shadow-[inset_0_0_0_1.5px_var(--color-accent)]"
    />
  </div>
  <div>
    <label for="company" class="mb-2 block text-sm font-medium text-text-primary">{t('form.company')}</label>
    <input
      id="company"
      name="company"
      type="text"
      class="h-12 w-full rounded-xl bg-[color-mix(in_oklab,var(--color-text-primary)_3%,transparent)] px-4 text-sm text-text-primary shadow-[inset_0_0_0_1px_color-mix(in_oklab,var(--color-text-primary)_11%,transparent)] outline-none transition-shadow duration-500 [transition-timing-function:cubic-bezier(0.32,0.72,0,1)] focus:shadow-[inset_0_0_0_1.5px_var(--color-accent)]"
    />
  </div>
  <div>
    <label for="service" class="mb-2 block text-sm font-medium text-text-primary">{t('form.service')}</label>
    <select
      id="service"
      name="service"
      required
      class="h-12 w-full rounded-xl bg-[color-mix(in_oklab,var(--color-text-primary)_3%,transparent)] px-4 text-sm text-text-primary shadow-[inset_0_0_0_1px_color-mix(in_oklab,var(--color-text-primary)_11%,transparent)] outline-none transition-shadow duration-500 [transition-timing-function:cubic-bezier(0.32,0.72,0,1)] focus:shadow-[inset_0_0_0_1.5px_var(--color-accent)]"
    >
      <option value="" selected disabled>{t('form.servicePlaceholder')}</option>
      {services.map((s) => <option value={s.title}>{s.title}</option>)}
    </select>
  </div>
  <div>
    <label for="message" class="mb-2 block text-sm font-medium text-text-primary">{t('form.message')}</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class="w-full py-3 rounded-xl bg-[color-mix(in_oklab,var(--color-text-primary)_3%,transparent)] px-4 text-sm text-text-primary shadow-[inset_0_0_0_1px_color-mix(in_oklab,var(--color-text-primary)_11%,transparent)] outline-none transition-shadow duration-500 [transition-timing-function:cubic-bezier(0.32,0.72,0,1)] focus:shadow-[inset_0_0_0_1.5px_var(--color-accent)]"
    ></textarea>
  </div>
  <button
    type="submit"
    class="cta-shine press flex h-13 w-full items-center justify-center rounded-full bg-accent-strong text-base font-semibold text-accent-foreground transition-colors duration-500 hover:bg-accent-strong-hover"
  >
    {t('form.submit')}
  </button>
  <p class="text-center text-xs text-text-secondary" data-form-note>{t('form.responseTime')}</p>
  <p
    class="hidden rounded-xl bg-[color-mix(in_oklab,var(--color-accent)_8%,transparent)] px-4 py-3 text-center text-sm text-text-primary"
    role="status"
    aria-live="polite"
    data-form-status
    data-success={t('form.success')}
    data-error={t('form.error')}
  >
  </p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const status = form.querySelector('[data-form-status]') as HTMLParagraphElement;
    const note = form.querySelector('[data-form-note]') as HTMLParagraphElement;
    const endpoint = form.dataset.endpoint!;
    const whatsapp = form.dataset.whatsapp!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = new FormData(form);
      const name = String(data.get('name') || '');
      const service = String(data.get('service') || '');

      // Underscore keys are FormSubmit directives, not form fields: they set
      // the mail subject and the reply-to, and skip the extra captcha page.
      data.append('_subject', `Nouveau projet : ${service}, ${name}`);
      data.append('_template', 'table');
      data.append('_captcha', 'false');
      data.append('page', window.location.href);

      button.disabled = true;
      button.textContent = form.dataset.labelSending!;

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        if (!res.ok) throw new Error('rejected');

        form.reset();
        note?.classList.add('hidden');
        status.textContent = status.dataset.success!;
        status.classList.remove('hidden');
        button.textContent = form.dataset.labelSubmit!;
      } catch {
        status.innerHTML = `${status.dataset.error} <a class="underline" href="${whatsapp}" target="_blank" rel="noopener">WhatsApp</a>`;
        status.classList.remove('hidden');
        button.textContent = form.dataset.labelSubmit!;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
