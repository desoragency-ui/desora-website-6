---
import { brandPattern } from '../lib/brand-assets';

/**
 * Scattered-letterform brand texture, echoing the DESORA monogram pattern.
 * Uses the real `public/brand/pattern.*` tile when present; otherwise renders
 * an inline tiling SVG of serif glyphs. Kept at a whisper opacity for editorial
 * restraint (never competes with content).
 */
interface Props {
  class?: string;
  opacity?: number;
  /** 'accent' = crimson glyphs (default). 'contrast' = cream glyphs, for use on crimson surfaces. */
  tone?: 'accent' | 'contrast';
  /** Tile size in px for the real pattern image. */
  tile?: number;
}

const { class: className = '', opacity = 0.05, tone = 'accent', tile = 460 } = Astro.props;
const fill = tone === 'contrast' ? 'var(--color-accent-foreground)' : 'var(--color-accent)';
// A crimson-on-white pattern export blends cleanly via multiply (white drops out)
// on light surfaces; on the crimson CTA we use the SVG recreation in cream instead.
const useRealImage = Boolean(brandPattern) && tone === 'accent';

// A single tile of rotated serif glyphs; the <pattern> repeats it seamlessly.
const glyphs = [
  { c: 'D', x: 26, y: 70, r: -12, s: 62 },
  { c: 'S', x: 120, y: 44, r: 18, s: 48 },
  { c: 'O', x: 196, y: 96, r: -8, s: 54 },
  { c: 'R', x: 70, y: 150, r: 24, s: 50 },
  { c: 'A', x: 168, y: 176, r: -20, s: 58 },
  { c: 'E', x: 232, y: 210, r: 10, s: 44 },
  { c: 'S', x: 30, y: 224, r: -16, s: 46 },
  { c: 'O', x: 128, y: 250, r: 14, s: 52 },
];
---

<div
  class:list={['pointer-events-none absolute inset-0 overflow-hidden', className]}
  style={`opacity:${opacity}`}
  aria-hidden="true"
>
  {
    useRealImage ? (
      <div
        class="absolute inset-0 mix-blend-multiply dark:mix-blend-screen"
        style={`background-image:url('${brandPattern}');background-size:${tile}px auto;background-repeat:repeat;`}
      />
    ) : (
  <svg width="100%" height="100%" preserveAspectRatio="xMidYMid slice">
    <defs>
      <pattern id="desora-glyphs" width="280" height="280" patternUnits="userSpaceOnUse">
        {
          glyphs.map((g) => (
            <text
              x={g.x}
              y={g.y}
              font-family="Cormorant, Georgia, serif"
              font-size={g.s}
              font-weight="600"
              fill={fill}
              transform={`rotate(${g.r} ${g.x} ${g.y})`}
            >
              {g.c}
            </text>
          ))
        }
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#desora-glyphs)"></rect>
  </svg>
    )
  }
</div>
