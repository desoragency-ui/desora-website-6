---
import { brandPattern } from '../lib/brand-assets';

/**
 * Scattered-letterform brand texture, built from the real DESORA pattern
 * artwork (`public/brand/pattern.png`) when present, else an inline SVG
 * recreation so the design never looks broken.
 *
 * The real artwork is a white+alpha MASK, so it takes the theme's colour via
 * `mask-image` (crimson in light, pearl in dark) exactly like the wordmark.
 * That also means the artwork's cream ground never touches the page surface,
 * and no blend mode is needed.
 *
 * `fit`:
 *  - 'cover'  (default) one large uncut wash of letterforms. The source art is
 *    not a seamless tile (its edges do not match), so repeating it would show
 *    a grid of seams. A single wash also reads more art-directed than wallpaper.
 *  - 'tile'   repeat at `tile` px. Only for the SVG fallback, which IS seamless.
 */
interface Props {
  class?: string;
  opacity?: number;
  /** 'accent' = crimson glyphs (default). 'contrast' = cream glyphs, for crimson surfaces. */
  tone?: 'accent' | 'contrast';
  /** Tile size in px, used only when fit="tile". */
  tile?: number;
  fit?: 'cover' | 'tile';
}

const { class: className = '', opacity = 0.05, tone = 'accent', tile = 460, fit = 'cover' } = Astro.props;

const fill = tone === 'contrast' ? 'var(--color-accent-foreground)' : 'var(--color-accent)';
const useRealImage = Boolean(brandPattern);

const maskSize = fit === 'tile' ? `${tile}px auto` : 'cover';
const maskRepeat = fit === 'tile' ? 'repeat' : 'no-repeat';
const maskStyle = useRealImage
  ? [
      `background-color:${fill}`,
      `-webkit-mask:url('${brandPattern}') center / ${maskSize} ${maskRepeat}`,
      `mask:url('${brandPattern}') center / ${maskSize} ${maskRepeat}`,
    ].join(';')
  : '';

// A single tile of rotated serif glyphs; the <pattern> repeats it seamlessly.
const glyphs = [
  { c: 'D', x: 26, y: 70, r: -12, s: 62 },
  { c: 'S', x: 120, y: 44, r: 18, s: 48 },
  { c: 'O', x: 196, y: 96, r: -8, s: 54 },
  { c: 'R', x: 70, y: 150, r: 24, s: 50 },
  { c: 'A', x: 168, y: 176, r: -20, s: 58 },
  { c: 'E', x: 232, y: 210, r: 10, s: 44 },
  { c: 'S', x: 30, y: 224, r: -16, s: 46 },
  { c: 'O', x: 128, y: 250, r: 14, s: 52 },
];
---

<div
  class:list={['pointer-events-none absolute inset-0 overflow-hidden', className]}
  style={`opacity:${opacity}`}
  aria-hidden="true"
>
  {
    useRealImage ? (
      <div class="absolute inset-0" style={maskStyle} />
    ) : (
      <svg width="100%" height="100%" preserveAspectRatio="xMidYMid slice">
        <defs>
          <pattern id="desora-glyphs" width="280" height="280" patternUnits="userSpaceOnUse">
            {glyphs.map((g) => (
              <text
                x={g.x}
                y={g.y}
                font-family="Cormorant, Georgia, serif"
                font-size={g.s}
                font-weight="600"
                fill={fill}
                transform={`rotate(${g.r} ${g.x} ${g.y})`}
              >
                {g.c}
              </text>
            ))}
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#desora-glyphs)"></rect>
      </svg>
    )
  }
</div>
