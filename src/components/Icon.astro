export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
const icon: IconDef = icons[name];
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke={icon.solid ? 'none' : 'currentColor'}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {icon.stroke && <path d={icon.stroke} />}
  {/* The second contour is what gives the set its depth. Kept at 38% so it
      reads as recession, never as a separate mark. */}
  {icon.accent && <path d={icon.accent} opacity="0.38" />}
  {icon.fill && <path d={icon.fill} fill="currentColor" stroke="none" />}
</svg>
