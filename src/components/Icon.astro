---
/**
 * The DESORA icon set.
 *
 * Every glyph is drawn on the same 24 grid at 1.5 stroke, with round caps and
 * joins and the same corner radii, so the set reads as one hand rather than a
 * pile of downloads. Most icons carry two layers:
 *
 *   stroke  the primary contour, full ink
 *   accent  a secondary contour at 38% ink, which is what gives the set its
 *           depth and keeps a 20px glyph from flattening into a pictogram
 *   fill    an occasional solid detail, the jewel in the setting
 *
 * Deliberate exception: pure controls (menu, close, check, chevrons, arrows)
 * stay single-path. Decorating a close button is noise, and at 16px a second
 * layer only muddies the shape.
 *
 * Second exception: whatsapp, instagram, linkedin and facebook are other
 * people's trademarks. They keep their own official geometry, because a
 * "restyled" brand mark is just a wrong brand mark.
 */

interface IconDef {
  stroke?: string;
  accent?: string;
  fill?: string;
  /** Brand marks ship as solid shapes, not contours. */
  solid?: boolean;
}

