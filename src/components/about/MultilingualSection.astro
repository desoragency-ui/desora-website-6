---
import Icon from '../Icon.astro';

interface Props {
  heading: string;
  description: string;
  languages: string[];
}

const { heading, description, languages } = Astro.props;
---

<section class="bg-bg-secondary py-20" data-curtain>
  <div class="mx-auto max-w-3xl px-5 text-center sm:px-8" data-reveal>
    <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-accent/10 text-accent">
      <Icon name="globe" class="h-5.5 w-5.5" />
    </span>
    <h2 class="mt-5 font-display text-2xl font-semibold text-text-primary sm:text-3xl" data-reveal="lines">{heading}</h2>
    <p class="mt-5 text-base leading-relaxed text-text-secondary">{description}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      {
        languages.map((lang) => (
          <span class="rounded-full border border-border bg-surface px-5 py-2.5 text-sm font-medium text-text-primary">
            {lang}
          </span>
        ))
      }
    </div>
  </div>
</section>
