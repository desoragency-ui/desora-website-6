---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import { locales, dirFor, hreflangTags, type Locale } from '../i18n/config';
import { brandFavicon } from '../lib/brand-assets';
import { useTranslations } from '../i18n/utils';
import { getHome, getServices } from '../lib/content';
import {
  organization,
  website,
  webPage,
  breadcrumbList,
  toJsonLd,
  type PageType,
  type SchemaNode,
} from '../lib/schema';
import { defaultOgImage, type OgImage } from '../lib/og';
import '../styles/global.css';

// Use the real brand icon if present, else the generated monogram favicon.
const faviconHref = brandFavicon ?? '/favicon.svg';
const faviconType = faviconHref.endsWith('.svg') ? 'image/svg+xml' : faviconHref.endsWith('.png') ? 'image/png' : undefined;

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Hide the site header and footer. Used by the brief quiz, which is a
   *  focused single-task page and carries its own minimal chrome: site
   *  navigation there is an invitation to abandon the form. */
  bare?: boolean;
  /** Keep the page out of search results (the quiz is invite-only). */
  noindex?: boolean;
  /** Page-specific JSON-LD nodes (Service, BlogPosting...), merged into the page's @graph. */
  schema?: SchemaNode[];
  /** @id of the node this page is about, e.g. the Service or BlogPosting it describes. */
  mainEntityId?: string;
  /** Short label for this page's last breadcrumb. Defaults to the title minus its brand suffix. */
  breadcrumbName?: string;
  /** Share-card image. Defaults to the branded card. */
  ogImage?: OgImage;
  /** Blog posts are articles to Open Graph; everything else is a website page. */
  ogType?: 'website' | 'article';
  /** Article publish date, printed as article:published_time. */
  publishedTime?: Date;
}

const {
  title,
  description,
  locale,
  bare = false,
  noindex = false,
  schema = [],
  mainEntityId,
  breadcrumbName,
  ogImage = defaultOgImage,
  ogType = 'website',
  publishedTime,
} = Astro.props;
const dir = dirFor(locale);

// Arabic pages set every glyph in Amiri (display) and Cairo (body); Latin pages
// never touch either. Splitting the request keeps eight unused font files off
// the critical path for the two locales that cannot render them anyway.
const isArabic = locale === 'ar';
const googleFontsHref = isArabic
  ? 'https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@400;500;600;700&display=swap'
  : 'https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,500;0,600;0,700;1,600&display=swap';

const url = Astro.url;
const segments = url.pathname.split('/').filter(Boolean);
const restPath = segments.slice(1).join('/');

const canonical = new URL(url.pathname, Astro.site);
const alternates = locales.map((l) => ({
  hreflang: hreflangTags[l],
  href: new URL(`/${l}${restPath ? `/${restPath}` : ''}`, Astro.site).toString(),
}));
const xDefaultHref = new URL(`/fr${restPath ? `/${restPath}` : ''}`, Astro.site).toString();

// Most content titles already end in "| DESORA" (or "| ديزورا"); appending the
// brand again produced "... | DESORA · DESORA". Only brand the ones that lack it.
const brand = isArabic ? 'ديزورا' : 'DESORA';
const fullTitle = /DESORA|ديزورا/.test(title) ? title : `${title} | ${brand}`;

// Open Graph wants ll_CC locales, not BCP-47 tags.
const ogLocales: Record<Locale, string> = { fr: 'fr_MA', en: 'en_US', ar: 'ar_MA' };
const ogImageUrl = new URL(ogImage.src, Astro.site).toString();

// Structured data: one connected @graph per indexable page. Page type and
// breadcrumb trail are read off the URL, so ordinary pages need no props;
// pages that describe a service, article or case study pass extra nodes.
let jsonLd: string | null = null;
if (!noindex) {
  const t = useTranslations(locale);
  const rest = segments.slice(1);
  const pageUrl = canonical.toString();

  const pageType: PageType =
    rest.length === 1 && rest[0] === 'a-propos'
      ? 'AboutPage'
      : rest.length === 1 && rest[0] === 'contact'
        ? 'ContactPage'
        : rest.length === 1 && rest[0] === 'blog'
          ? 'CollectionPage'
          : 'WebPage';

  // Only real pages go in the trail: /services and /realisations have no
  // index page of their own, /blog does.
  const trail: { name: string; url: string }[] = [];
  if (rest.length > 0) {
    trail.push({ name: t('nav.home'), url: new URL(`/${locale}`, Astro.site).toString() });
    if (rest[0] === 'blog' && rest.length > 1) {
      trail.push({ name: t('nav.blog'), url: new URL(`/${locale}/blog`, Astro.site).toString() });
    }
    trail.push({ name: breadcrumbName ?? title.split(' | ')[0], url: pageUrl });
  }

  const home = await getHome(locale);
  const services = await getServices(locale);

  const nodes: SchemaNode[] = [
    organization(home?.seoDescription ?? description, services.map((s) => s.title)),
    website(),
    webPage({
      url: pageUrl,
      name: fullTitle,
      description,
      locale,
      type: pageType,
      hasBreadcrumb: trail.length > 0,
      mainEntityId,
    }),
    ...(trail.length > 0 ? [breadcrumbList(pageUrl, trail)] : []),
    ...schema,
  ];
  jsonLd = toJsonLd(nodes);
}
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3EK57K0EJB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-3EK57K0EJB');
    </script>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('desora-theme');
          var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
        try {
          if (sessionStorage.getItem('desora-preloader-shown')) {
            document.documentElement.classList.add('preloader-skip');
          }
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type={faviconType} href={faviconHref} />
    <link rel="apple-touch-icon" href={faviconHref} />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* A noindex page has nothing to canonicalise or localise: pointing search
        engines at alternates of a page they must not index sends mixed signals. */}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical.toString()} />}
    {!noindex && alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="DESORA" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImage.type} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={fullTitle} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#161616" />
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {
      !isArabic && (
        <>
          <link rel="preconnect" href="https://api.fontshare.com" />
          <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
        </>
      )
    }
    <!-- Faces are requested PER LOCALE. Loading Cairo's five weights and
         Amiri's three on every French page meant every visitor downloaded
         eight Arabic font files they would never see a glyph of, on the
         critical path. Latin pages now ask for Cormorant + General Sans only,
         Arabic pages for Amiri + Cairo only. Weights are trimmed to the ones
         actually set in global.css. -->
    <link rel="stylesheet" href={googleFontsHref} />
    {
      !isArabic && (
        <link
          rel="stylesheet"
          href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&display=swap"
        />
      )
    }
  </head>
  <body class="overflow-x-hidden bg-bg-primary text-text-primary">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-md focus:bg-accent-strong focus:px-4 focus:py-2 focus:text-accent-foreground"
    >
      Aller au contenu
    </a>
    {/* One fixed grain pass over the whole page. Fixed and pointer-events-none
        so it is painted once instead of repainting with every scrolled frame.
        It is what keeps large flat fields of Pearl from reading as untouched
        #FFF, which is the difference between "printed" and "rendered". */}
    <Preloader />
    {/* Reading progress. Purely decorative, so it stays out of the a11y tree. */}
    <div
      id="scroll-progress"
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-0 z-[95] h-px origin-left scale-x-0 bg-gold"
    >
    </div>
    {!bare && <Header locale={locale} />}
    <main id="main-content">
      <slot />
    </main>
    {!bare && <Footer locale={locale} />}
    <FloatingCTA locale={locale} />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
